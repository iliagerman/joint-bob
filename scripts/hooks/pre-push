#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
REMOTE_NAME="${1:-origin}"
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "${remote_ref}" = "refs/heads/main" ] || continue
  [ "${local_sha}" != "0000000000000000000000000000000000000000" ] || continue
  # Blocking: a deployment does not leave without its version and release notes.
  node "${ROOT}/scripts/changelog-gate.mjs" "${remote_sha}" "${local_sha}" </dev/null >&2
  log_dir="${HOME}/.joint-bob/logs"
  mkdir -p "${log_dir}"
  chmod 700 "${HOME}/.joint-bob" "${log_dir}"
  nohup "${ROOT}/scripts/wait-for-main-and-deploy.sh" "${local_sha}" "${REMOTE_NAME}" >> "${log_dir}/push-deploy.log" 2>&1 </dev/null &
done
